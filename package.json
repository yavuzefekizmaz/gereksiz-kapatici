{
  "name": "voldena",
  "version": "1.0.0",
  "description": "Voldena - Ultra Oyun Hızlandırıcısı",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "game-booster",
    "process-manager",
    "ram-cleaner",
    "automation",
    "electron"
  ],
  "author": "Voldena Development",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.voldena.gamebooster",
    "productName": "Voldena Oyun Hizlandiricisi",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Voldena Oyun Hizlandiricisi",
      "perMachine": true,
      "executionLevel": "requireAdministrator"
    }
  }
}
